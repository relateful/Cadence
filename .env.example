# Cadence configuration. Copy this file to .env and fill in what you need.
# Every variable is optional except CADENCE_PASSWORD. Values shown are the defaults.

# Shared secret your bot sends in the Authorization header on every REST and
# WebSocket request. Required. Lavalink's default "youshallnotpass" is refused.
CADENCE_PASSWORD=

# Address and port to listen on. Point your Lavalink client at this.
CADENCE_ADDRESS=0.0.0.0:2333

# Log verbosity: debug, info, warn or error.
CADENCE_LOG_LEVEL=info

# How often playerUpdate is sent while a track plays, in milliseconds (minimum 250).
# An update is also sent immediately after every event.
CADENCE_UPDATE_INTERVAL_MS=1000

# How long players keep playing after your bot disconnects, in seconds, when the
# bot enabled resuming. Reconnect within this window and nothing stops.
CADENCE_RESUME_TIMEOUT_SECONDS=300

# File where sessions are saved on shutdown, so a Cadence restart resumes every
# player where it stopped. Leave empty to start fresh on every restart.
CADENCE_STATE_FILE=

# Decoded audio buffered ahead per deck, in milliseconds (1000–60000). Larger
# values ride out slow sources better and use more memory per player.
CADENCE_BUFFER_MS=10000

# Default Opus bitrate in bits per second, used when the bot does not send the
# channel's bitrate. Clamped to 16000–384000.
CADENCE_BITRATE=96000

# Measured delay between Discord receiving audio and listeners hearing it, in
# milliseconds. It is added to TrackAudibleEvent.audibleAt so synced lyrics land
# on time. Measure it against a recorded client rather than guessing.
CADENCE_PLAYOUT_DELAY_MS=0

# Fade length for pause and resume, in milliseconds (0 to 2000). A pause fades
# the music out before it stops and a resume fades it back in. 0 turns it off
# and pauses on the next frame.
CADENCE_PAUSE_FADE_MS=0

# Level every track to the same loudness using its analysis, so quiet and loud
# masters play at the same volume. Tracks not yet analysed play unchanged.
CADENCE_NORMALIZE=true

# Loudness target for levelling, in LUFS (−30 to −5). −14 matches most streaming services.
CADENCE_NORMALIZE_LUFS=-14

# Directory for the audio cache. A track played twice within 7 days is saved as
# it plays, so later plays and seeks need no source requests. Empty disables it.
CADENCE_AUDIO_CACHE_DIR=

# Maximum cache size in gigabytes (1–1000). Least recently played tracks go first.
CADENCE_AUDIO_CACHE_GB=20

# Which catalogs plain-text searches query, in order. Results are matched to a
# playable Deezer track, with SoundCloud as the fallback.
CADENCE_SEARCH_ORDER=applemusic,spotify,deezer

# Offline track analysis (tempo, key, loudness, structure) used for automix and
# levelling: how many tracks are analysed at once, and how many may wait.
# Work beyond the queue limit is dropped and analysed on a later request instead.
CADENCE_ANALYSIS_WORKERS=2
CADENCE_ANALYSIS_QUEUE=32

# Session cookie ("arl") of a Deezer account. Without it searches still work but
# full-length Deezer playback does not (previews are never played).
# Several accounts can be listed, separated by commas. When Deezer rejects one
# (expired or logged out) it sits out for 15 minutes and the next one is used,
# and a track one account is not allowed to stream is tried on the next.
DEEZER_ARL=

# Which account each stream starts with when DEEZER_ARL lists several:
# failover (default) always starts with the first working account and only moves
# on when it fails; round-robin takes turns; random picks one at random. The
# remaining accounts are always kept as fallbacks. Spreading one server's
# streams across accounts can make Deezer treat them as shared, so prefer
# failover unless you have a reason not to.
DEEZER_ARL_ROTATION=failover

# 16-byte key for Deezer's stream cipher. Without it nothing plays at all.
DEEZER_MASTER_KEY=

# Prefer 128 kbps MP3 over 64 kbps when the account allows it.
DEEZER_HIGH_QUALITY=true

# Optional HTTP proxy for Deezer requests, e.g. http://user:pass@host:port.
# If the proxy fails, Cadence goes direct for 60 seconds and then tries it again.
DEEZER_PROXY=

# Spotify Web API app credentials. Used to resolve Spotify links and searches to
# a playable track by ISRC. Without them Spotify links do not resolve.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PROXY=

# Optional fixed developer token. Leave empty and Cadence fetches one itself.
APPLE_MUSIC_TOKEN=

# Two-letter catalog storefront to search, e.g. us, gb, de.
APPLE_MUSIC_STOREFRONT=us
APPLE_MUSIC_PROXY=

# Play from SoundCloud when Deezer has no match for a track.
SOUNDCLOUD_ENABLED=true

# Optional fixed client id. Leave empty and Cadence fetches one itself.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_PROXY=

# Cadence refuses to start without voice support (libopus and libdave, the
# "native" build). Set true to run anyway, e.g. to work on search on Windows or macOS.
# CADENCE_ALLOW_NO_VOICE=true
